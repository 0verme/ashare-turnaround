# Secrets and local configuration
.env
.env.*
!.env.example

# Local datasets / generated data
# Keep only directory markers in the repository; runtime contents stay local.
data/*
!data/.gitkeep
data/raw/*
!data/raw/
!data/raw/.gitkeep
data/derived/*
!data/derived/
!data/derived/.gitkeep
data/reports/*
!data/reports/
!data/reports/.gitkeep
data/state/*
!data/state/
!data/state/.gitkeep

# Root-level data work areas. The source package under src/ remains trackable.
/datasets/
/downloads/
/cache/
/tmp/
/raw/
/staging/
/warehouse/

# Financial / analytical datasets
*.parquet
*.parquet.*
*.feather
*.arrow
*.duckdb
*.duckdb.*
*.sqlite
*.sqlite3
*.db
*.db-*
*.csv
*.csv.*
*.jsonl
*.jsonl.*

# Small checked-in fixtures/samples may be versioned.
!tests/fixtures/
!tests/fixtures/**
!examples/sample/
!examples/sample/**

# Python
__pycache__/
*.py[cod]
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/

# Editors and OS
.vscode/
.idea/
.DS_Store
